# Copy this file to .env.local and fill in your credentials
# Never commit .env.local to git

# Intercom access token
# Get from: https://app.intercom.com/a/developer-signup → Your App → Authentication
INTERCOM_ACCESS_TOKEN=your_intercom_access_token_here

# Close CRM API key
# Get from: Close Settings → API & Webhooks → Generate API Key
CLOSE_API_KEY=your_close_api_key_here

# Stripe secret key (sk_live_... or sk_test_...)
# Get from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Anthropic API key (sk-ant-...)
# Get from: platform.claude.com → API keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
